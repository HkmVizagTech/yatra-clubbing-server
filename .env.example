# Server
PORT=3000

# MongoDB (Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.f6wu1ck.mongodb.net/?appName=Cluster0
MONGODB_DB=yatra

# Admin auth (frontend admin posts this token to /api/admin/login)

# CORS - the frontend origin(s) allowed to call this API (comma-separated)
FRONTEND_URL=http://localhost:3001,https://your-app.vercel.app

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (student ID uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp via Gupshup — real values live in Railway only, never in this repo.
GUPSHUP_API_KEY=
GUPSHUP_APP_ID=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE=

# Gupshup template ids (UUIDs from the Gupshup dashboard). The booking one is
# sent the moment a payment succeeds; the two student-ID ones are sent when an
# admin approves or rejects a college ID. A message is skipped, with a warning
# in the log, when its id is missing.
GUPSHUP_TEMPLATE_BOOKING=
GUPSHUP_TEMPLATE_STUDENT_APPROVED=
GUPSHUP_TEMPLATE_STUDENT_REJECTED=

# Admin sign-in (JWT). JWT_SECRET: a random string of 32+ characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Creates the FIRST super admin when no admin users exist yet. Ignored afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare R2 — student ID card uploads (private bucket, viewed via signed links)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# optional: a separate private bucket just for ID cards
R2_ID_BUCKET=

# Vanabhojanam "who attended" API (returning-attendee pricing)
VANABHOJANAM_API_URL=
VANABHOJANAM_API_KEY=
