# Server
PORT=3000

# MongoDB (Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.f6wu1ck.mongodb.net/?appName=Cluster0
MONGODB_DB=yatra

# Admin auth (frontend admin posts this token to /api/admin/login)
ADMIN_TOKEN=change-me

# CORS - the frontend origin(s) allowed to call this API (comma-separated)
FRONTEND_URL=http://localhost:3001,https://your-app.vercel.app

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (student ID uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp via Gupshup — real values live in Railway only, never in this repo.
GUPSHUP_API_KEY=
GUPSHUP_APP_ID=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE=

# Gupshup template ids (UUIDs from the Gupshup dashboard). The booking one is
# sent the moment a payment succeeds; the two student-ID ones are sent when an
# admin approves or rejects a college ID. A message is skipped, with a warning
# in the log, when its id is missing.
GUPSHUP_TEMPLATE_BOOKING=
GUPSHUP_TEMPLATE_STUDENT_APPROVED=
GUPSHUP_TEMPLATE_STUDENT_REJECTED=
